+/** Operator-only accepted read of exactly the proven rev5 target. Never used
+ * to admit a candidate. Keep native readiness and legal checks untouched. */
+export async function openPreviouslyAcceptedRev5ForSuccessor(storage:ObjectJsonStorage,pin:{
+ checksum:string;etag:string;allowExactPreviouslyPublishedBackup?:string;assertCurrent:()=>Promise<void>;
+}){
+ const oldSha='fd69b2d1e628759e7658f13139268f2513fe0afbf7b83b9ebaee1f26233c57a5';
+ const rev5='9e3f73d6282465019f43dcd0370bf9c71688445a0e361dccf641bd45acc5be62';
+ const backup=pin.allowExactPreviouslyPublishedBackup!==undefined;
+ if(typeof pin.assertCurrent!=='function'||!SHA.test(pin.checksum)||!pin.etag||
+   (!backup&&pin.checksum!==rev5)||(backup&&pin.allowExactPreviouslyPublishedBackup!==oldSha))return fail('accepted_rev5_scope');
+ const read=async()=>{
+  await pin.assertCurrent();
+  const live=await readChinaPublicState(storage);
+  const old=backup?live?.state.previous:live?.state.active;
+  if(!live||live.checksum!==pin.checksum||live.etag!==pin.etag||live.state.revision!==(backup?6:5)||
+     !old||chinaLegacyRollback(old)||chinaObjectDigest(old)!==oldSha)return fail('accepted_rev5_changed');
+  return old;
+ };
+ const old=await read(),files=await openChinaStageObject(storage,old,async()=>{await read();},true);
+ if(files.acceptedLegalUntil===undefined||Date.now()>=files.acceptedLegalUntil)return fail('accepted_rev5_legal');
+ return files;
+}
