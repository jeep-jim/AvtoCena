+++ b/scripts/catalog-china-daily-source-once.mts
@@ -0,0 +1,80 @@
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import {fileURLToPath,pathToFileURL} from 'node:url';
+import {parseArgs} from 'node:util';
+import {constants} from 'node:fs';
+import {createHash} from 'node:crypto';
+import {ObjectJsonStorage} from '../apps/web/lib/data';
+import {assertCollectionEnabled} from '../apps/web/lib/catalog/collection-controls';
+import {autoApiChe168Client} from './lib/auto-api-che168-client.mjs';
+import {collectChinaDailySource} from './catalog-china-daily-collect-core.mts';
+import {createChinaDailySourceAuthority} from './catalog-china-daily-source-authority.mts';
+import {openChinaDailySourcePrivateStore} from './catalog-china-daily-source-private-store.mts';
+
+const sha=(bytes:Buffer)=>createHash('sha256').update(bytes).digest('hex');
+async function pinnedLocal(file:string|undefined,max:number){
+ if(!file)throw Error('china_daily_once:missing_argument');
+ const name=path.resolve(file);
+ if(await fs.realpath(name)!==name)throw Error('china_daily_once:local_input');
+ const f=await fs.open(name,constants.O_RDONLY|constants.O_NOFOLLOW);try{
+  const before=await f.stat();
+  if(!before.isFile()||before.size<1||before.size>max)throw Error('china_daily_once:local_input');
+  const buffer=Buffer.alloc(before.size),r=await f.read(buffer,0,before.size,0),after=await f.stat();
+  if(r.bytesRead!==before.size||after.size!==before.size||after.mtimeMs!==before.mtimeMs||after.ctimeMs!==before.ctimeMs)throw Error('china_daily_once:local_input');
+  return buffer;
+ }finally{await f.close();}
+}
+function claimPrivateLocalOutput(name:string|undefined,scratch:string|undefined){
+ if(!name||!scratch)throw Error('china_daily_once:private_result_path');
+ const temp=path.resolve(scratch),out=path.resolve(name);
+ if(path.dirname(out)!==temp||path.basename(out)!=='china-daily-archive-private.json')throw Error('china_daily_once:private_result_path');
+ return {temp,out};
+}
+let phase='preflight',providerRequestAttempted=false;
+async function main(){
+ const {values}=parseArgs({options:{approval:{type:'string'},'approval-sha':{type:'string'},'dry-plan':{type:'string'},
+   'bootstrap-receipt':{type:'string'},'private-result-file':{type:'string'},'private-temp':{type:'string'}}});
+ const approved=await pinnedLocal(values.approval,16384),dry=await pinnedLocal(values['dry-plan'],16384);
+ const original=await pinnedLocal(values['bootstrap-receipt'],16384);
+ const {temp,out}=claimPrivateLocalOutput(values['private-result-file'],values['private-temp']);
+ const st=await fs.stat(temp);
+ if(await fs.realpath(temp)!==temp||!st.isDirectory()||(st.mode&0o077)!==0)throw Error('china_daily_once:private_result_path');
+ await fs.access(out).then(()=>{throw Error('china_daily_once:private_result_exists');},e=>{if(e?.code!=='ENOENT')throw e;});
+ const workerRoot=path.dirname(path.dirname(fileURLToPath(import.meta.url)));
+ const snapshot=await pinnedLocal(path.join(workerRoot,'data/catalog/che168-snapshot-v1.json'),128*1024);
+ const authority=createChinaDailySourceAuthority({plan:approved,expectedPlanSha256:values['approval-sha']??'',
+  actorRoot:path.dirname(workerRoot),workerRoot});
+ if(sha(dry)!==authority.dryPlanSha256)throw Error('china_daily_once:dry_plan_sha');
+ phase='authority';await authority.attest(true);
+ phase='bucket_privacy';
+ const storage=await openChinaDailySourcePrivateStore({native:new ObjectJsonStorage(),owner:authority.owner,assertAuthority:authority.attest});
+ // Fixed standard client, no alternate identity, endpoint or access mode.
+ const client=autoApiChe168Client({apiKey:process.env.AUTO_API_CHE168_KEY,deadline:Date.now()+210*60_000,requestDelayMs:200,retryRateLimit:false});
+ const result=await collectChinaDailySource({plan:dry,expectedPlanSha256:authority.dryPlanSha256,snapshotConfig:snapshot,bootstrapReceipt:original},
+  {storage,authorize:authority.authorize,nativeWitness:authority.nativeWitness,assertEnabled:()=>assertCollectionEnabled('che168_feed'),request:client,
+   progress(next){phase=next;if(next==='provider_request')providerRequestAttempted=true;}});
+ phase='post_archive_privacy';
+ await storage.assertPrivate(true);
+ if(result.outcome==='archive_verified'){
+  const bytes=Buffer.from(JSON.stringify(result.receipt));
+  if(sha(bytes)!==result.receiptSha256)throw Error('china_daily_once:private_receipt_sha');
+  await fs.writeFile(out,bytes,{mode:0o600,flag:'wx'});
+ }
