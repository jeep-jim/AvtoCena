+++ b/scripts/catalog-china-daily-source-authority.mts
@@ -0,0 +1,123 @@
+import {createHash} from 'node:crypto';
+import {execFileSync} from 'node:child_process';
+import {lstatSync,readFileSync,realpathSync} from 'node:fs';
+import path from 'node:path';
+import {fileURLToPath} from 'node:url';
+import {performance} from 'node:perf_hooks';
+import {verifyChe168ReplicaInput} from './lib/che168-replica-witness.mjs';
+
+const SHA=/^[a-f0-9]{64}$/,GIT=/^[a-f0-9]{40}$/,ID=/^[1-9]\d{0,19}$/;
+const hash=(x:Buffer)=>createHash('sha256').update(x).digest('hex');
+const need=(v:unknown,c:string)=>{if(!v)throw Error('china_daily_authority:'+c);};
+const REPO='jeep-jim/AvtoCena',REPO_ID='1289722938';
+export const CHINA_DAILY_SOURCE_WORKFLOW='.github/workflows/china-independent-daily-source-collect-v1.yml';
+export const CHINA_DAILY_SOURCE_MARKER='.github/market-runs/china-independent-daily-source-collect-v4.sha256';
+export const CHINA_DAILY_SOURCE_TITLE='Collect one independent China delta with frozen-port fix without publication';
+const API='https://api.github.com/repos/'+REPO+'/actions/runs';
+// Existing source collectors, not unrelated publication, UI or neighbor jobs.
+const SOURCE_WORKFLOWS=new Set([CHINA_DAILY_SOURCE_WORKFLOW,'.github/workflows/collect-china-ordinary-20261119.yml',
+ '.github/workflows/catalog-refresh-china.yml','.github/workflows/catalog-v2-china.yml','.github/workflows/che168-diagnose.yml']);
+const ARCHIVE='459c98611117227fa68ae336f1f65c7de939ef4bdb4d8f8e2f132ace171d4247';
+const BOOTSTRAP='3b59460ceca450b10d5565fd31da6d1da10c993498a7419085327bb2594524d3';
+const CONTROL='9e3f73d6282465019f43dcd0370bf9c71688445a0e361dccf641bd45acc5be62';
+type Claim={controlSha256:string;replicaSha256:string;cursor:number};
+type Owner={runId:string;attempt:string;revision:string};
+type Approved={version:1;kind:'china-daily-source-collect-approval-v1';dryPlanSha256:string;controlSha256:string;
+ cursor:number;workflowSha256:string;workerHead:string;workerTree:string;maxJobMs:number;noPublication:true;noCursorWrite:true};
+const fields=['version','kind','dryPlanSha256','controlSha256','cursor','workflowSha256','workerHead','workerTree','maxJobMs','noPublication','noCursorWrite'];
+function parsePlan(raw:Buffer,expected:string):Readonly<Approved>{
+ need(Buffer.isBuffer(raw)&&raw.length>1&&raw.length<=16_384&&SHA.test(expected)&&hash(raw)===expected,'approved_bytes');
+ let p:Approved;try{p=JSON.parse(new TextDecoder('utf-8',{fatal:true}).decode(raw));}catch{throw Error('china_daily_authority:approved_json');}
+ need(p&&Object.keys(p).length===fields.length&&Object.keys(p).every(k=>fields.includes(k))&&p.version===1&&
+  p.kind==='china-daily-source-collect-approval-v1'&&p.dryPlanSha256===BOOTSTRAP&&p.controlSha256===CONTROL&&p.cursor===13123821&&
+  SHA.test(p.workflowSha256)&&GIT.test(p.workerHead)&&GIT.test(p.workerTree)&&Number.isSafeInteger(p.maxJobMs)&&
+  p.maxJobMs>=10*60_000&&p.maxJobMs<=320*60_000&&p.noPublication===true&&p.noCursorWrite===true,'approved_scope');
+ return Object.freeze(p!);
+}
+function git(cwd:string,...args:string[]){
+ try{
+  const env={...process.env};for(const k of Object.keys(env))if(k.startsWith('GIT_'))delete env[k];
+  env.GIT_CONFIG_NOSYSTEM='1';env.GIT_CONFIG_GLOBAL='/dev/null';env.GIT_TERMINAL_PROMPT='0';
+  return execFileSync('git',args,{cwd,env,encoding:'buffer',maxBuffer:1024*1024,timeout:20_000,stdio:['ignore','pipe','pipe']});
+ }catch{throw Error('china_daily_authority:git_check');}
+}
+function safeFile(root:string,relative:string,max:number){
+ const absolute=path.join(root,relative),st=lstatSync(absolute);
+ need(realpathSync(absolute)===absolute&&st.isFile()&&st.size>0&&st.size<=max,'pinned_local_file');
+ return readFileSync(absolute);
+}
+async function boundedJson(response:Response){
+ if(response.status!==200||!response.body){await response.body?.cancel();throw Error('china_daily_authority:github_response');}
+ const pieces:Buffer[]=[];let n=0;
+ for await(const chunk of response.body){n+=chunk.length;need(n<=2*1024**2,'github_bytes');pieces.push(Buffer.from(chunk));}
+ try{return JSON.parse(Buffer.concat(pieces).toString('utf8'));}catch{throw Error('china_daily_authority:github_json');}
+}
+export function createChinaDailySourceAuthority(input:{plan:Buffer;expectedPlanSha256:string;actorRoot:string;workerRoot:string;
+ env?:NodeJS.ProcessEnv;fetchImpl?:typeof fetch}){
+ const p=parsePlan(input.plan,input.expectedPlanSha256),env=input.env??process.env,fetcher=input.fetchImpl??globalThis.fetch;
+ const actor=path.resolve(input.actorRoot),worker=path.resolve(input.workerRoot);
+ const actorRevision=env.GITHUB_SHA,runId=env.GITHUB_RUN_ID,token=env.GITHUB_TOKEN;
+ const now=Date.now(),mono=performance.now(),clock=()=>now+Math.max(performance.now()-mono,Date.now()-now);
+ need(GIT.test(actorRevision??'')&&actorRevision!==p.workerHead&&ID.test(runId??''),'bound_runtime_identity');
+ need(typeof token==='string'&&token.length<=4096&&(/^ghs_[A-Za-z0-9]{36}$/.test(token)||/^ghs_[0-9]{1,20}_[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/.test(token)),'github_installation_token_shape');
+ need(realpathSync(actor)===actor&&realpathSync(worker)===worker&&actor!==worker&&
+  path.dirname(worker)===actor&&worker===path.dirname(path.dirname(fileURLToPath(import.meta.url))),'bound_runtime_roots');
+ // Record actual Actions writer identity as owner; worker code gets its own attestation.
+ const owner=Object.freeze({runId:runId!,attempt:'1',revision:actorRevision!});
+ const checkEnv=()=>need(env.GITHUB_REPOSITORY===REPO&&env.GITHUB_REPOSITORY_ID===REPO_ID&&env.GITHUB_REF==='refs/heads/main'&&
+  env.GITHUB_WORKFLOW_REF===REPO+'/'+CHINA_DAILY_SOURCE_WORKFLOW+'@refs/heads/main'&&env.GITHUB_EVENT_NAME==='push'&&env.GITHUB_JOB==='collect'&&
+  env.GITHUB_RUN_ID===runId&&env.GITHUB_RUN_ATTEMPT==='1'&&env.GITHUB_SHA===actorRevision&&env.GITHUB_TOKEN===token,'job_environment');
+ const workerCheck=()=>{
+  need(git(worker,'rev-parse','--verify','HEAD').toString().trim()===p.workerHead&&git(worker,'write-tree').toString().trim()===p.workerTree&&
+    git(worker,'diff','--name-only','--').length===0&&git(worker,'ls-files','--others','--exclude-standard','--','apps','packages','scripts','data').length===0&&
+    git(worker,'ls-files','--others','--ignored','--exclude-standard','--','apps','packages','scripts','data').length===0&&
+    hash(safeFile(worker,'scripts/lib/nonjp-intake-archive.mjs',128*1024))===ARCHIVE,'worker_tree');
+ };
+ const actorCheck=()=>{
+  const workflow=safeFile(actor,CHINA_DAILY_SOURCE_WORKFLOW,128*1024),marker=safeFile(actor,CHINA_DAILY_SOURCE_MARKER,128);
+  need(git(actor,'rev-parse','--verify','HEAD').toString().trim()===owner.revision&&hash(workflow)===p.workflowSha256&&
+   workflow.equals(git(actor,'show',owner.revision+':'+CHINA_DAILY_SOURCE_WORKFLOW))&&
+   /^concurrency:\n {2}group: catalog-refresh-china\n {2}cancel-in-progress: false$/m.test(workflow.toString('utf8'))&&
+   marker.toString('ascii')===input.expectedPlanSha256+'\n'&&marker.equals(git(actor,'show',owner.revision+':'+CHINA_DAILY_SOURCE_MARKER)),'actor_tree');
+ };
+ async function req(url:string){return boundedJson(await fetcher(url,{method:'GET',redirect:'error',headers:{authorization:'Bearer '+token,
+  accept:'application/vnd.github+json','accept-encoding':'identity'},signal:AbortSignal.timeout(15_000)}));}
+ let nextCheck=0,deadline=0,initialReplica:string|undefined,flight:Promise<void>|undefined;
+ async function remote(){
+  checkEnv();actorCheck();workerCheck();
+  const self=API+'/'+runId,[run,jobs,active]=await Promise.all([req(self),req(self+'/attempts/1/jobs?per_page=100'),req(API+'?status=in_progress&per_page=100')]);
+  const job=jobs.jobs?.filter((row:any)=>row?.name===CHINA_DAILY_SOURCE_TITLE);
+  const started=Date.parse(job?.[0]?.started_at);
+  need(String(run.id)===runId&&run.run_attempt===1&&run.head_sha===actorRevision&&run.head_branch==='main'&&run.path===CHINA_DAILY_SOURCE_WORKFLOW&&
+   run.event==='push'&&run.status==='in_progress'&&run.head_commit?.message===CHINA_DAILY_SOURCE_TITLE&&
+   String(run.repository?.id)===REPO_ID&&run.repository?.full_name===REPO&&
+   Array.isArray(jobs.jobs)&&jobs.total_count===jobs.jobs.length&&jobs.total_count<=100&&job?.length===1&&
+   String(job[0].run_id)===runId&&job[0].head_sha===actorRevision&&job[0].status==='in_progress'&&
+   Number.isFinite(started)&&started<=clock()+5_000&&started+p.maxJobMs>clock(),'remote_job');
+  need(Array.isArray(active.workflow_runs)&&active.total_count===active.workflow_runs.length&&active.total_count<=100&&
+   active.workflow_runs.some((row:any)=>String(row.id)===runId&&row.path===CHINA_DAILY_SOURCE_WORKFLOW&&row.head_sha===actorRevision)&&
+   active.workflow_runs.every((row:any)=>String(row.id)===runId||!SOURCE_WORKFLOWS.has(row.path)),'source_lane_busy_or_unknown');
+  if(deadline)need(deadline===started+p.maxJobMs,'job_start_changed');
+  deadline=started+p.maxJobMs;nextCheck=clock()+60_000;
+ }
+ async function attest(force=false){
+  checkEnv();if(deadline)need(clock()<deadline,'job_deadline');
+  if(!deadline||force||clock()>=nextCheck){
+   if(!flight)flight=remote().finally(()=>{flight=undefined;});
+   await flight;
+  }
+  checkEnv();need(clock()<deadline,'job_deadline');
+ }
+ const authorize=async(claim:Claim)=>{
+  need(claim?.controlSha256===p.controlSha256&&claim.cursor===p.cursor&&SHA.test(claim.replicaSha256)&&
+    (!initialReplica||initialReplica===claim.replicaSha256),'accepted_claim');
+  await attest();initialReplica=claim.replicaSha256;
+ };
+ return Object.freeze({owner,workerHead:p.workerHead,workerTree:p.workerTree,dryPlanSha256:p.dryPlanSha256,attest,authorize,
+  async nativeWitness({storage,directory,config,owner:actual}:{storage:any;directory:string;config:any;owner:Owner}){
+   need(actual?.runId===owner.runId&&actual.attempt===owner.attempt&&actual.revision===owner.revision&&Boolean(initialReplica),'native_provenance');
+   await attest(true);workerCheck();
+   const witness=await verifyChe168ReplicaInput({storage,directory,config,producer:{runId:owner.runId,attempt:owner.attempt,sourceSha:owner.revision},independentDailySource:true});
+   await attest(true);return {sourceInputWitness:witness};
+  }});
+}
