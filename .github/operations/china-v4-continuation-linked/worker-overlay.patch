+import {createHash} from 'node:crypto';
+import {gunzipSync} from 'node:zlib';
+import {ObjectJsonStorage} from '../data';
+import {assertDurableIntakeArchive} from '../../../../scripts/lib/catalog-raw-provenance.mjs';
+import {chinaObjectDigest,openAcceptedChinaRegcloudFiles,type ChinaStageObjectFiles} from './china-regcloud-object-reader';
+import {openIndependentChinaRegcloud,type IndependentCut} from './independent-market-activation-fixture';
+
+const SHA=/^[a-f0-9]{64}$/, ROOT=/^catalog\/nonjp-intake\/v1\/china\/[1-9]\d{0,19}\/[1-9]\d{0,5}$/;
+const REPLICA=/^catalog\/provider-replicas\/che168\/[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/;
+const MiB=1024**2, PART=2*MiB, REPLICA_PART=16*MiB, MAX_REPORT=128*MiB, MAX_RECEIPT=16*1024;
+const fail=(reason:string):never=>{throw Error('china_daily_source:'+reason);};
+const sha=(b:Buffer)=>createHash('sha256').update(b).digest('hex');
+const parse=(bytes:Buffer)=>JSON.parse(new TextDecoder('utf-8',{fatal:true}).decode(bytes));
+const int=(n:unknown):n is number=>Number.isSafeInteger(n)&&Number(n)>0;
+type Source=IndependentCut['source'];
+type Anchor={root:string;manifestSha256:string;reportSha256:string;receiptSha256:string};
+type ReplicaChunkSink=(chunk:Buffer,index:number)=>Promise<void>;
+type Replica={key:string;binding:string;cursor:number;sha256:string};
+export type ChinaDailySourceCheckpoint={
+ version:1;kind:'china-daily-source-checkpoint-v1';market:'china';archive:Anchor;replica:Replica;
+ observedAt:number;sourceRows:number;
+};
+export type ChinaDailyBase={checksum:string;etag:string};
+
+function anchorFromReceipt(b:Buffer,source:Source,archiveSha256:string):Anchor{
+ if(!Buffer.isBuffer(b)||b.length<1||b.length>MAX_RECEIPT||sha(b)!==source.receiptSha256)return fail('receipt_sha');
+ const raw=parse(b);
+ let receipt;try{receipt=assertDurableIntakeArchive(raw,'china');}catch{return fail('archive_receipt');}
+ if(receipt.manifestSha256!==archiveSha256||!ROOT.test(receipt.root))return fail('archive_receipt');
+ return {root:receipt.root,manifestSha256:receipt.manifestSha256,reportSha256:receipt.reportDigest,receiptSha256:source.receiptSha256};
+}
+async function openArchiveSource(storage:ObjectJsonStorage,anchor:Anchor,source:Source,archiveSha256:string,guard:()=>Promise<void>,verifyReplicaParts:boolean,expectedSnapshotBinding?:string,onVerifiedReplicaChunk?:ReplicaChunkSink){
+ if(!anchor||!ROOT.test(anchor.root)||![anchor.manifestSha256,anchor.receiptSha256,anchor.reportSha256].every(x=>SHA.test(x??''))||
+    anchor.manifestSha256!==archiveSha256||anchor.receiptSha256!==source.receiptSha256||source.cursor.stream!=='che168')return fail('archive_scope');
+ const read=async(key:string,max:number)=>{await guard();const r=await storage.getBinaryBounded(key,max);await guard();return r.data;};
+ const manifest=parse(await read(anchor.root+'/complete.json',2*MiB));
+ if(chinaObjectDigest(manifest)!==archiveSha256||manifest?.version!==1||manifest.kind!=='nonjp-intake'||manifest.market!=='china'||
+    manifest.collection?.complete!==true||manifest.reportDigest!==anchor.reportSha256||!Array.isArray(manifest.files)||manifest.files.length>20_000||
+    anchor.root!=='catalog/nonjp-intake/v1/china/'+manifest.owner?.runId+'/'+manifest.owner?.attempt)return fail('archive_manifest');
+ const entries=manifest.files.filter((f:{name?:string}|null)=>f?.name==='report.json');
+ const f=entries[0];
+ if(entries.length!==1||!int(f.bytes)||f.bytes>MAX_REPORT||f.sha256!==anchor.reportSha256||!Array.isArray(f.parts)||
+    f.parts.length!==Math.ceil(f.bytes/PART))return fail('archive_report_manifest');
+ const bytes=Buffer.alloc(f.bytes),hash=createHash('sha256');
+ for(const [i,part] of f.parts.entries()){
+  const size=Math.min(PART,f.bytes-i*PART);
+  if(!SHA.test(part?.sha256??'')||part.bytes!==size||part.key!==anchor.root+'/files/report.json/'+i+'-'+part.sha256+'.json')
+   return fail('report_shard_scope');
+  const wire=parse(await read(part.key,4*MiB));
+  if(wire?.version!==1||wire.encoding!=='gzip-base64'||wire.sha256!==part.sha256||wire.bytes!==size||
+     typeof wire.payload!=='string'||wire.payload.length>4*MiB)return fail('report_shard_wire');
+  const encoded=Buffer.from(wire.payload,'base64');
+  if(encoded.toString('base64')!==wire.payload)return fail('report_shard_wire');
+  let raw;try{raw=gunzipSync(encoded,{maxOutputLength:size});}catch{return fail('report_shard_integrity');}
+  if(raw.length!==size||sha(raw)!==part.sha256)return fail('report_shard_integrity');
+  raw.copy(bytes,i*PART);hash.update(raw);
+ }
+ if(hash.digest('hex')!==anchor.reportSha256)return fail('report_sha');
