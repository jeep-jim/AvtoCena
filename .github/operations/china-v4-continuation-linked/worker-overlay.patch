+  if(!transferred||!result.completed||result.failure||!result.sourceInputWitness||
+      !source?.completeInventory||source.stopReason!=='source_finished'||source.initialCursor!==claim.cursor||source.cursor<=claim.cursor||
+      source.baseReplica?.sha256!==claim.replicaSha256||source.observations!==source.uniqueOffers)throw Error('china_daily_collect:unsealed_source');
+  mark('archive');
+  const receipt=await archiveIntakeDirectory({storage,directory:observations,market:'china',owner});
+  await guard();
+  const raw=await fs.readFile(path.join(observations,'own-storage-receipt.json'));
+  return {outcome:'archive_verified',cursor:source.cursor,offers:source.uniqueOffers,receipt,receiptSha256:createHash('sha256').update(raw).digest('hex'),
+    publicationAuthorized:false,cursorAdvanceAuthorized:false} as const;
+ }finally{await fs.rm(root,{recursive:true,force:true});}
+}
