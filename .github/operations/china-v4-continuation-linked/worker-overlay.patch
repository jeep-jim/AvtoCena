+      await fs.unlink(replica);
+    }},directory:observations,storage,resolvePolicy:async()=>{mark('owner_controls');await ports.assertEnabled();},
+    request:async(endpoint:string,params:Record<string,unknown>)=>{
+      const names=Object.keys(params);
+      if(names.length!==1||!(endpoint==='changes'&&names[0]==='change_id'&&Number.isSafeInteger(params.change_id)&&Number(params.change_id)>=claim.cursor
+        ||endpoint==='offer'&&names[0]==='inner_id'&&/^[0-9]{1,20}$/.test(String(params.inner_id))))throw Error('china_daily_collect:provider_scope');
+      if(++requests>15_000||Date.now()>=until)throw Error('china_daily_collect:provider_budget');
+      await guard();
+      mark('provider_request');
+      return ports.request(endpoint,params);
+    }});
+  await guard();
+  if('noDelta' in result)return {outcome:'no_delta',cursor:claim.cursor,publicationAuthorized:false,cursorAdvanceAuthorized:false} as const;
