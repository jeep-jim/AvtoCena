+/** In-process source-only core. No executable entry, environment grant, global
+ * publish/legacy cursor fallback, or operator marker. Host must inject the
+ * independently authenticated producer scope. */
+import {createHash} from 'node:crypto';
+import type {ObjectJsonStorage} from '../apps/web/lib/data';
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import {inspectChinaDailyDry,type ChinaDailyNativeBase} from './catalog-china-daily-dry.mts';
+import {runChe168BulkIntake} from './catalog-auto-api-che168-bulk-intake.mjs';
+import {rawDigest,rawProducerOwner} from './lib/catalog-raw-provenance.mjs';
+import {archiveIntakeDirectory} from './lib/nonjp-intake-archive.mjs';
+
+type Input=Pick<Parameters<typeof inspectChinaDailyDry>[0],'plan'|'expectedPlanSha256'|'snapshotConfig'|'bootstrapReceipt'>;
+type Ports={
+ storage:Pick<ObjectJsonStorage,'driver'|'readJson'|'readJsonWithMeta'|'putBinary'|'writeJson'|'getBinary'> & {listBucketObjects(prefix?:string):Promise<{size:number}[]>};
+ nativeWitness?:(args:any)=>Promise<any>;
+ authorize:(claim:{controlSha256:string;replicaSha256:string;cursor:number})=>Promise<void>;
+ assertEnabled:()=>Promise<void>;
+ request:(endpoint:string,params:Record<string,unknown>)=>Promise<unknown>;
+ progress?:(phase:'base_read'|'replica_spool'|'guard'|'policy'|'pin_read'|'pin_put'|'owner_controls'|'provider_request'|'archive')=>void;
+};
+export async function collectChinaDailySource(input:Input,ports:Ports){
+ const owner=rawProducerOwner(),root=await fs.mkdtemp(path.join(os.tmpdir(),'china-daily-source-'));
+ try{
+  const replica=path.join(root,'replica.sqlite'),observations=path.join(root,'collection');
+  let verified:ChinaDailyNativeBase|undefined,parts=0;
+  const mark=(phase:Parameters<NonNullable<Ports['progress']>>[0])=>ports.progress?.(phase);
+  mark('replica_spool');
+  const file=await fs.open(replica,'wx',0o600);
+  mark('base_read');
+  const evidence=await (async()=>{try{return await inspectChinaDailyDry({...input,
+    onVerifiedReplicaChunk:async(bytes,index)=>{
+      if(index!==parts++)throw Error('china_daily_collect:replica_order');
+      mark('replica_spool');await file.writeFile(bytes);mark('base_read');
+    },onVerifiedBase:base=>{verified=base;}});}
+    finally{await file.close();}})();
+  if(!verified||!parts)throw Error('china_daily_collect:verified_base');
+  const base=verified,claim=Object.freeze({controlSha256:evidence.controlSha256,
+    replicaSha256:base.checkpoint.replica.sha256,cursor:base.checkpoint.replica.cursor});
+  const guard=async()=>{mark('guard');await ports.authorize(claim);await base.assertCurrent();};
+  await guard();
+  const initialJournal='catalog/intake-working/che168-v1/'+evidence.nativeResume.artifactRunId+'/';
+  const archiveRoot=`catalog/nonjp-intake/v1/china/${owner.runId}/${owner.attempt}/`;
+  const collectorPin=`catalog/raw-feed-pins/v1/che168-intake-${owner.runId}-${owner.attempt}.json`;
+  const expectedPins=new Set([
+    collectorPin,
+    `catalog/raw-feed-pins/v1/nonjp-intake-china-${owner.runId}-${owner.attempt}.json`,
+  ]);
+  const rawRep=/^catalog\/provider-replicas\/che168\/[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}\/(?:manifest\.json|(?:0|[1-9]\d{0,3})\.gz)$/;
+  const baseRoot=base.checkpoint.replica.key;
+  const snapshotRoot='catalog/provider-snapshots/che168/'+base.checkpoint.replica.binding;
+  const snapshotMapping='catalog/raw-feed-handoffs/v1/che168-snapshot/'+rawDigest(snapshotRoot)+'.json';
+  const policyKey='catalog/raw-feed-coordination/v1/policy.json',stateKey='catalog/raw-feed-coordination/v1/state.json';
+  const rawRoot=(key:string)=>rawRep.test(key)?key.slice(0,key.lastIndexOf('/')):null;
+  const journalKey=(key:string)=>key.startsWith(initialJournal)&&/^(?:head|[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12})\.json$/.test(key.slice(initialJournal.length));
+  const archiveKey=(key:string)=>key.startsWith(archiveRoot)&&/^(?:complete\.json|files\/(?:report\.json|autohome_used_china_open-\d{6}\.jsonl)\/\d{1,6}-[a-f0-9]{64}\.json)$/.test(key.slice(archiveRoot.length));
+  // The first independent collect does not mutate a shared raw registry or
+  // retire any roots. If the optional registry is ACTIVE, fail before intake;
+  // do not pretend a verified GET grants its writer role.
+  mark('policy');
+  const [policy,state]=await Promise.all([policyKey,stateKey].map(key=>ports.storage.readJsonWithMeta(key,null)));
+  if(policy.found!==false||state.found!==false)throw Error('china_daily_collect:shared_raw_registry_enabled');
+  let newReplica:string|undefined,lister=0;
+  const storage=new Proxy(Object.create(null) as Ports['storage'],{
+    set:()=>false,defineProperty:()=>false,deleteProperty:()=>false,
+    get(_shell,prop){
+    // A guard returns a new method; it cannot proxy a frozen own method directly.
+    const target=ports.storage,value=Reflect.get(target,prop,target);
+    if(typeof value!=='function')return value;
+    if(prop==='writeJson'||prop==='putBinary')return async(key:string,...args:unknown[])=>{
+      if(!expectedPins.has(key)&&!journalKey(key)&&!archiveKey(key)&&(!newReplica||rawRoot(key)!==newReplica))
+        throw Error('china_daily_collect:write_scope');
+      if(key===collectorPin&&prop==='writeJson'){
+        const refs=(args[0] as {references?:{kind:string;root:string}[]})?.references??[];
+        const candidates=refs.filter(r=>r.kind==='che168-replica'&&r.root!==baseRoot);
+        if(candidates.length>1||candidates.some(r=>rawRoot(r.root+'/manifest.json')!==r.root||(newReplica&&newReplica!==r.root)))
+          throw Error('china_daily_collect:replica_scope');
+        if(candidates[0])newReplica=candidates[0].root;
+      }
+      await guard();
+      if(key===collectorPin)mark('pin_put');
+      return value.call(target,key,...args);
+    };
+    if(['readJson','readJsonWithMeta','getBinary','getBinaryBounded','readJsonBounded'].includes(String(prop)))return(key:string,...args:unknown[])=>{
+      // If the policy becomes present after preflight, native raw helpers
+      // may try to read the shared registry. That request is not allowed.
+      if(!expectedPins.has(key)&&!journalKey(key)&&!archiveKey(key)&&key!==policyKey&&key!==stateKey&&key!==snapshotMapping&&key!==snapshotRoot+'/manifest.json'
+         && (rawRoot(key)===null||!(rawRoot(key)===baseRoot||rawRoot(key)===newReplica)))throw Error('china_daily_collect:read_scope');
+      if(key===collectorPin)mark('pin_read');
+      else if(key===policyKey||key===stateKey)mark('policy');
+      return value.call(target,key,...args);
+    };
+    // Existing byte reserve is a bounded read-only bucket census, not a
+    // cross-market lease. No results leave the collector process.
+    if(prop==='listBucketObjects')return async(prefix='')=>{
+      if(prefix!==''||++lister!==1)throw Error('china_daily_collect:reserve_scope');
+      await guard();return value.call(target,prefix);
+    };
+    return ()=>{throw Error('china_daily_collect:unsupported_storage_operation');};
+  }});
+  let transferred=false,requests=0;
+  const until=Date.now()+210*60_000;
+  const result=await runChe168BulkIntake({accepted:{config:base.config,saved:base.saved,assertCurrent:guard,nativeWitness:ports.nativeWitness,
+    restore:async(filename:string,descriptor:typeof base.checkpoint.replica)=>{
+      if(transferred||JSON.stringify(descriptor)!==JSON.stringify(base.checkpoint.replica))throw Error('china_daily_collect:replica_identity');
+      transferred=true;
