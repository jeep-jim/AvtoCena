+import {createHash} from 'node:crypto';
+import {ObjectJsonStorage,type JsonWriteCondition} from '../apps/web/lib/data';
+import {readConfiguredRegcloudScope} from '../apps/web/lib/catalog/china-regcloud-object-reader';
+
+const scope={endpoint:'https://s3.regru.cloud',bucket:'avtocena-staging-8120751',region:'us-east-1',prefix:'migration-staging/full-20261011'};
+const demand=(cond:unknown,code:string)=>{if(!cond)throw Error('china_daily_privacy:'+code);};
+type Native=Pick<ObjectJsonStorage,'readChinaPrivateStageBucketPrivacy'|'readChinaDailySourceJson'|
+ 'putChinaDailySourcePrivate'|'getChinaReplicaPartBounded'|'listChinaDailyArchiveReserve'>;
+type Own={runId:string;attempt:string};
+/** Performs real signed readback with existing owner's credentials only.
+ * Called only after independent GitHub actor proof. The core applies the more
+ * specific ancestry-derived journal/replica/read key predicates atop this port. */
+export async function openChinaDailySourcePrivateStore({native,owner,assertAuthority}:{native:Native;owner:Own;assertAuthority:(force?:boolean)=>Promise<void>}){
+ demand(/^[1-9]\d{0,19}$/.test(owner.runId)&&owner.attempt==='1','owner_scope');
+ const before=readConfiguredRegcloudScope();
+ demand(Object.entries(scope).every(([k,v])=>before[k as keyof typeof before]===v),'storage_scope');
+ await assertAuthority(true);
+ const privacy=await native.readChinaPrivateStageBucketPrivacy();
+ const archive=`catalog/nonjp-intake/v1/china/${owner.runId}/${owner.attempt}/`;
+ const pins=new Set([ `catalog/raw-feed-pins/v1/che168-intake-${owner.runId}-${owner.attempt}.json`,
+  `catalog/raw-feed-pins/v1/nonjp-intake-china-${owner.runId}-${owner.attempt}.json`]);
+ let last=Date.now(),flight:Promise<void>|undefined,objects=0,total=0;
+ function pathAllowed(key:string){return pins.has(key)||key.startsWith(archive)||/^catalog\/(?:intake-working\/che168-v1|provider-replicas\/che168)\//.test(key);}
+ async function privacyStill(force=false){
+  await assertAuthority(force);
+  if(!force&&Date.now()-last<60_000)return;
+  if(!flight)flight=(async()=>{
+   const after=await native.readChinaPrivateStageBucketPrivacy();
+   demand(after.owner===privacy.owner&&after.policySha256===privacy.policySha256,'bucket_privacy_changed');
+   last=Date.now();
+  })().finally(()=>{flight=undefined;});
+  await flight;
+ }
+ async function put(key:string,bytes:Buffer,type:'application/json'|'application/gzip',condition?:JsonWriteCondition){
+  demand(pathAllowed(key),'write_scope');
+  demand(++objects<=28_000&&(total+=bytes.length)<=20*1024**3,'write_budget');
+  await privacyStill();
+  return native.putChinaDailySourcePrivate(key,bytes,type,condition!,privacy.owner);
+ }
+ const readJsonWithMeta=async<T>(key:string,fallback:T)=>native.readChinaDailySourceJson(key,fallback);
+ return Object.freeze({driver:'object' as const,assertPrivate:privacyStill,readJsonWithMeta,
+   async readJson<T>(key:string,fallback:T){return (await readJsonWithMeta(key,fallback)).value;},
+   async writeJson(key:string,value:unknown,condition?:JsonWriteCondition){await put(key,Buffer.from(JSON.stringify(value)),'application/json',condition);},
+   async putBinary(key:string,bytes:Buffer,type:string,condition?:JsonWriteCondition){demand(type==='application/gzip','binary_type');return put(key,bytes,'application/gzip',condition);},
+   async getBinary(key:string){const data=await native.getChinaReplicaPartBounded(key,17*1024**2);return {data,size:data.length,checksum:createHash('sha256').update(data).digest('hex')};},
+   async listBucketObjects(prefix?:string){demand((prefix??'')==='','reserve_scope');await privacyStill();return native.listChinaDailyArchiveReserve();},
+  });
+}
