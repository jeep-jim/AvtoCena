+type Input=Pick<Parameters<typeof inspectChinaDailyDry>[0],'plan'|'expectedPlanSha256'|'snapshotConfig'|'bootstrapReceipt'>;
+type Ports={
+ storage:Pick<ObjectJsonStorage,'driver'|'readJson'|'readJsonWithMeta'|'putBinary'|'writeJson'|'getBinary'> & {listBucketObjects(prefix?:string):Promise<{size:number}[]>};
+ nativeWitness?:(args:any)=>Promise<any>;
+ authorize:(claim:{controlSha256:string;replicaSha256:string;cursor:number})=>Promise<void>;
+ assertEnabled:()=>Promise<void>;
+ request:(endpoint:string,params:Record<string,unknown>)=>Promise<unknown>;
+};
+export async function collectChinaDailySource(input:Input,ports:Ports){
+ const owner=rawProducerOwner(),root=await fs.mkdtemp(path.join(os.tmpdir(),'china-daily-source-'));
+ try{
+  const replica=path.join(root,'replica.sqlite'),observations=path.join(root,'collection');
+  let verified:ChinaDailyNativeBase|undefined,parts=0;
+  const file=await fs.open(replica,'wx',0o600);
+  const evidence=await (async()=>{try{return await inspectChinaDailyDry({...input,
+    onVerifiedReplicaChunk:async(bytes,index)=>{
+      if(index!==parts++)throw Error('china_daily_collect:replica_order');
+      await file.writeFile(bytes);
+    },onVerifiedBase:base=>{verified=base;}});}
+    finally{await file.close();}})();
+  if(!verified||!parts)throw Error('china_daily_collect:verified_base');
+  const base=verified,claim=Object.freeze({controlSha256:evidence.controlSha256,
+    replicaSha256:base.checkpoint.replica.sha256,cursor:base.checkpoint.replica.cursor});
+  const guard=async()=>{await ports.authorize(claim);await base.assertCurrent();};
+  await guard();
+  const initialJournal='catalog/intake-working/che168-v1/'+evidence.nativeResume.artifactRunId+'/';
+  const archiveRoot=`catalog/nonjp-intake/v1/china/${owner.runId}/${owner.attempt}/`;
+  const collectorPin=`catalog/raw-feed-pins/v1/che168-intake-${owner.runId}-${owner.attempt}.json`;
+  const expectedPins=new Set([
+    collectorPin,
+    `catalog/raw-feed-pins/v1/nonjp-intake-china-${owner.runId}-${owner.attempt}.json`,
+  ]);
+  const rawRep=/^catalog\/provider-replicas\/che168\/[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}\/(?:manifest\.json|(?:0|[1-9]\d{0,3})\.gz)$/;
+  const baseRoot=base.checkpoint.replica.key;
+  const snapshotRoot='catalog/provider-snapshots/che168/'+base.checkpoint.replica.binding;
+  const snapshotMapping='catalog/raw-feed-handoffs/v1/che168-snapshot/'+rawDigest(snapshotRoot)+'.json';
+  const policyKey='catalog/raw-feed-coordination/v1/policy.json';
+  const rawRoot=(key:string)=>rawRep.test(key)?key.slice(0,key.lastIndexOf('/')):null;
+  const journalKey=(key:string)=>key.startsWith(initialJournal)&&/^(?:head|[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12})\.json$/.test(key.slice(initialJournal.length));
+  const archiveKey=(key:string)=>key.startsWith(archiveRoot)&&/^(?:complete\.json|files\/(?:report\.json|autohome_used_china_open-\d{6}\.jsonl)\/\d{1,6}-[a-f0-9]{64}\.json)$/.test(key.slice(archiveRoot.length));
