+    };
+    return ()=>{throw Error('china_daily_collect:unsupported_storage_operation');};
+  }});
+  let transferred=false,requests=0;
+  const until=Date.now()+210*60_000;
+  const result=await runChe168BulkIntake({accepted:{config:base.config,saved:base.saved,assertCurrent:guard,nativeWitness:ports.nativeWitness,
+    restore:async(filename:string,descriptor:typeof base.checkpoint.replica)=>{
+      if(transferred||JSON.stringify(descriptor)!==JSON.stringify(base.checkpoint.replica))throw Error('china_daily_collect:replica_identity');
