+import {createHash} from 'node:crypto';
+import {execFileSync} from 'node:child_process';
+import {lstatSync,readFileSync,realpathSync} from 'node:fs';
+import path from 'node:path';
+import {fileURLToPath} from 'node:url';
+import {performance} from 'node:perf_hooks';
+import {verifyChe168ReplicaInput} from './lib/che168-replica-witness.mjs';
+
+const SHA=/^[a-f0-9]{64}$/,GIT=/^[a-f0-9]{40}$/,ID=/^[1-9]\d{0,19}$/;
+const hash=(x:Buffer)=>createHash('sha256').update(x).digest('hex');
+const need=(v:unknown,c:string)=>{if(!v)throw Error('china_daily_authority:'+c);};
+const REPO='jeep-jim/AvtoCena',REPO_ID='1289722938';
+export const CHINA_DAILY_SOURCE_WORKFLOW='.github/workflows/china-independent-daily-source-collect-v1.yml';
+export const CHINA_DAILY_SOURCE_MARKER='.github/market-runs/china-independent-daily-source-collect-v1.sha256';
+export const CHINA_DAILY_SOURCE_TITLE='Collect one independent China delta without publication';
+const API='https://api.github.com/repos/'+REPO+'/actions/runs';
+// Existing source collectors, not unrelated publication, UI or neighbor jobs.
+const SOURCE_WORKFLOWS=new Set([CHINA_DAILY_SOURCE_WORKFLOW,'.github/workflows/collect-china-ordinary-20261119.yml',
+ '.github/workflows/catalog-refresh-china.yml','.github/workflows/catalog-v2-china.yml','.github/workflows/che168-diagnose.yml']);
+const ARCHIVE='459c98611117227fa68ae336f1f65c7de939ef4bdb4d8f8e2f132ace171d4247';
+const BOOTSTRAP='3b59460ceca450b10d5565fd31da6d1da10c993498a7419085327bb2594524d3';
+const CONTROL='9e3f73d6282465019f43dcd0370bf9c71688445a0e361dccf641bd45acc5be62';
+type Claim={controlSha256:string;replicaSha256:string;cursor:number};
+type Owner={runId:string;attempt:string;revision:string};
+type Approved={version:1;kind:'china-daily-source-collect-approval-v1';dryPlanSha256:string;controlSha256:string;
+ cursor:number;workflowSha256:string;workerHead:string;workerTree:string;maxJobMs:number;noPublication:true;noCursorWrite:true};
+const fields=['version','kind','dryPlanSha256','controlSha256','cursor','workflowSha256','workerHead','workerTree','maxJobMs','noPublication','noCursorWrite'];
+function parsePlan(raw:Buffer,expected:string):Readonly<Approved>{
+ need(Buffer.isBuffer(raw)&&raw.length>1&&raw.length<=16_384&&SHA.test(expected)&&hash(raw)===expected,'approved_bytes');
+ let p:Approved;try{p=JSON.parse(new TextDecoder('utf-8',{fatal:true}).decode(raw));}catch{throw Error('china_daily_authority:approved_json');}
+ need(p&&Object.keys(p).length===fields.length&&Object.keys(p).every(k=>fields.includes(k))&&p.version===1&&
+  p.kind==='china-daily-source-collect-approval-v1'&&p.dryPlanSha256===BOOTSTRAP&&p.controlSha256===CONTROL&&p.cursor===13123821&&
+  SHA.test(p.workflowSha256)&&GIT.test(p.workerHead)&&GIT.test(p.workerTree)&&Number.isSafeInteger(p.maxJobMs)&&
+  p.maxJobMs>=10*60_000&&p.maxJobMs<=320*60_000&&p.noPublication===true&&p.noCursorWrite===true,'approved_scope');
+ return Object.freeze(p!);
+}
+function git(cwd:string,...args:string[]){
+ try{
+  const env={...process.env};for(const k of Object.keys(env))if(k.startsWith('GIT_'))delete env[k];
+  env.GIT_CONFIG_NOSYSTEM='1';env.GIT_CONFIG_GLOBAL='/dev/null';env.GIT_TERMINAL_PROMPT='0';
+  return execFileSync('git',args,{cwd,env,encoding:'buffer',maxBuffer:1024*1024,timeout:20_000,stdio:['ignore','pipe','pipe']});
+ }catch{throw Error('china_daily_authority:git_check');}
+}
+function safeFile(root:string,relative:string,max:number){
+ const absolute=path.join(root,relative),st=lstatSync(absolute);
+ need(realpathSync(absolute)===absolute&&st.isFile()&&st.size>0&&st.size<=max,'pinned_local_file');
+ return readFileSync(absolute);
+}
+async function boundedJson(response:Response){
+ if(response.status!==200||!response.body){await response.body?.cancel();throw Error('china_daily_authority:github_response');}
+ const pieces:Buffer[]=[];let n=0;
+ for await(const chunk of response.body){n+=chunk.length;need(n<=2*1024**2,'github_bytes');pieces.push(Buffer.from(chunk));}
