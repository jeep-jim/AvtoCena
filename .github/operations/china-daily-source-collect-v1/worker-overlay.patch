+    }},directory:observations,storage,resolvePolicy:ports.assertEnabled,
+    request:async(endpoint:string,params:Record<string,unknown>)=>{
+      const names=Object.keys(params);
+      if(names.length!==1||!(endpoint==='changes'&&names[0]==='change_id'&&Number.isSafeInteger(params.change_id)&&Number(params.change_id)>=claim.cursor
+        ||endpoint==='offer'&&names[0]==='inner_id'&&/^[0-9]{1,20}$/.test(String(params.inner_id))))throw Error('china_daily_collect:provider_scope');
