+    if(prop==='writeJson'||prop==='putBinary')return async(key:string,...args:unknown[])=>{
+      if(!expectedPins.has(key)&&!journalKey(key)&&!archiveKey(key)&&(!newReplica||rawRoot(key)!==newReplica))
+        throw Error('china_daily_collect:write_scope');
+      if(key===collectorPin&&prop==='writeJson'){
+        const refs=(args[0] as {references?:{kind:string;root:string}[]})?.references??[];
+        const candidates=refs.filter(r=>r.kind==='che168-replica'&&r.root!==baseRoot);
+        if(candidates.length>1||candidates.some(r=>rawRoot(r.root+'/manifest.json')!==r.root||(newReplica&&newReplica!==r.root)))
+          throw Error('china_daily_collect:replica_scope');
+        if(candidates[0])newReplica=candidates[0].root;
+      }
+      await guard();
+      return value.call(target,key,...args);
+    };
+    if(['readJson','readJsonWithMeta','getBinary','getBinaryBounded','readJsonBounded'].includes(String(prop)))return(key:string,...args:unknown[])=>{
+      // If the policy becomes present after preflight, native raw helpers
+      // may try to read the shared registry. That request is not allowed.
+      if(!expectedPins.has(key)&&!journalKey(key)&&!archiveKey(key)&&key!==policyKey&&key!==snapshotMapping&&key!==snapshotRoot+'/manifest.json'
+         && (rawRoot(key)===null||!(rawRoot(key)===baseRoot||rawRoot(key)===newReplica)))throw Error('china_daily_collect:read_scope');
+      return value.call(target,key,...args);
+    };
+    // Existing byte reserve is a bounded read-only bucket census, not a
+    // cross-market lease. No results leave the collector process.
+    if(prop==='listBucketObjects')return async(prefix='')=>{
+      if(prefix!==''||++lister!==1)throw Error('china_daily_collect:reserve_scope');
