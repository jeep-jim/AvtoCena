+  const key=decodeURIComponent(u.pathname.slice(bound.length));
+  if(!allow(key)||++gets>12_000||Date.now()-begin>=600_000)return fail('read_scope_or_budget');
+  seen.add(key);
+  return original(raw,init);
+ };
+ try{
+  const storage=new ObjectJsonStorage(),before=await readChinaPublicState(storage);
+  if(!before||before.checksum!==p.controlSha256||before.state.revision!==p.revision||chinaLegacyRollback(before.state.active)||
+    chinaObjectDigest(before.state.active)!==chinaObjectDigest(p.target))return fail('accepted_pointer');
+  const stage=await openAcceptedChinaRegcloudFiles(storage,before,'active');
+  if(stage.ready.archiveSha256!==p.archiveSha256)return fail('archive_pin');
+  const accepted=await openChinaDailyAcceptedSource(storage,before,input.bootstrapReceipt,expectedSnapshotBinding,input.onVerifiedReplicaChunk);
+  const a=accepted.checkpoint;
+  if(a.archive.root!==p.archiveRoot||a.archive.manifestSha256!==p.archiveSha256)return fail('archive_pin');
+  // No data is written into the legacy cursor. This in-memory adapter is the
+  // exact input the existing native bulk collector would use, not authority.
+  const saved={version:1,market:'china',generationId:p.target.generationId,updatedAt:new Date(a.observedAt).toISOString(),
+   sources:[{sourceId,provider:'auto_api_che168',snapshotBinding:a.replica.binding,yearFrom:CHINA_MIN_MODEL_YEAR,
+    cursor:a.replica.cursor,replica:a.replica,stopReason:'source_finished'}]};
+  const native=resolveChe168BulkResume({config,saved,sourceId,yearFrom:CHINA_MIN_MODEL_YEAR,required:true});
+  if(!native.resume||native.initialCursor!==a.replica.cursor||native.binding!==a.replica.binding)return fail('native_continuity');
+  await accepted.assertCurrent();
+  input.onVerifiedBase?.({config,saved,checkpoint:a,assertCurrent:accepted.assertCurrent});
+  const now=Date.now();
+  return {version:1,kind:'china-independent-daily-dry-evidence-v1',market:'china',generationId:p.target.generationId,revision:p.revision,
+   controlSha256:p.controlSha256,sourceObservedAt:new Date(a.observedAt).toISOString(),sourceRows:a.sourceRows,
+   currentStageDraftExpired:now>=stage.ready.validUntil,currentStageDraftValidUntil:stage.ready.validUntil,acceptedLegalUntil:stage.acceptedLegalUntil??stage.ready.validUntil,
+   nativeResume:{mode:'local_replica_and_changes',initialCursor:native.initialCursor,replicaSha256:a.replica.sha256,
+    snapshotBinding:native.binding,journalBinding:native.journalBinding,artifactRunId:native.artifactRunId},
+   nextArchiveMustBeFresh:true,scheduleHeld:true,scheduledUtc:'14:00',signedStorageGets:gets,distinctObjects:seen.size,
+   supplierRequests:0,storageWrites:0,publicationAuthorized:false,cursorAdvanceAuthorized:false};
+ }finally{globalThis.fetch=original;}
+}
+async function local(file:string,max:number){
+ const resolved=path.resolve(file);
+ if(await fs.realpath(resolved)!==resolved)return fail('local_file');
+ const handle=await fs.open(resolved,'r');try{
+  const st=await handle.stat();
+  if(!st.isFile()||st.size<1||st.size>max)return fail('local_file');
+  const b=await handle.readFile();if(b.length!==st.size)return fail('local_file');return b;
+ }finally{await handle.close();}
+}
+if(process.argv[1]&&import.meta.url===pathToFileURL(path.resolve(process.argv[1])).href){
+ try{
+  const {values:v}=parseArgs({options:{plan:{type:'string'},'expect-plan-sha':{type:'string'},'snapshot-config':{type:'string'},'bootstrap-receipt':{type:'string'}}});
+  if(!v.plan||!v['expect-plan-sha']||!v['snapshot-config'])throw Error('china_daily_dry:args');
+  const detail=await inspectChinaDailyDry({plan:await local(v.plan,16*1024),expectedPlanSha256:v['expect-plan-sha'],
+   snapshotConfig:await local(v['snapshot-config'],128*1024),bootstrapReceipt:v['bootstrap-receipt']?await local(v['bootstrap-receipt'],16*1024):undefined});
+  console.log(JSON.stringify(detail));
+ }catch(e){
+  const msg=e instanceof Error?e.message:'';
+  console.error(JSON.stringify({status:'held',reason:/^(?:china_daily_dry|china_daily_source|china_own_regcloud):[a-z0-9_]+$/.test(msg)?msg:
+   /^auto_api_(?:saved_replica_required|invalid_saved_replica_cursor|invalid_snapshot_config)$/.test(msg)?msg:'source_validation_unverified',
+   scheduleHeld:true,supplierRequests:0,storageWrites:0,publicationAuthorized:false,cursorAdvanceAuthorized:false}));
+  process.exitCode=1;
+ }
+}
