@@ -0,0 +1,19 @@
+import {createHash} from 'node:crypto';
+import {snapshotBinding} from './che168-snapshot.mjs';
+
+/** Exact native Che168 start state. This function does no IO and has no
+ * permission to collect, save a cursor, choose a global publisher or retry. */
+export function resolveChe168BulkResume({config,saved,sourceId,yearFrom,required=false,now=Date.now()}){
+ const binding=snapshotBinding(config);
+ const previous=saved?.sources?.find(row=>row.sourceId===sourceId);
+ const resume=previous?.snapshotBinding===binding && previous.yearFrom===yearFrom;
+ if(required&&!resume)throw Error('auto_api_saved_replica_required');
+ if(resume&&(saved.version!==1||saved.market!=='china'||!saved.generationId||previous.provider!=='auto_api_che168'
+  ||!Number.isSafeInteger(previous.cursor)||previous.cursor<config.initialCursor||!previous.replica
+  ||!Number.isFinite(Date.parse(saved.updatedAt))||Date.parse(saved.updatedAt)>now
+  ||previous.stopReason!=='source_finished'))throw Error('auto_api_invalid_saved_replica_cursor');
+ const initialCursor=resume?previous.cursor:config.initialCursor;
+ const journalBinding=createHash('sha256').update(JSON.stringify({binding,initialCursor,base:resume?previous.replica:null,replayVersion:2})).digest('hex');
+ const artifactRunId=BigInt('0x'+journalBinding.slice(0,14)).toString();
+ return {binding,previous,resume,initialCursor,journalBinding,artifactRunId};
+}
