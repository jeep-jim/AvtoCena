+/** Open only a pointer's accepted active/previous reference, never an
+ * arbitrary expired private draft. Both the initial witness and every
+ * subsequent read are fenced to the same opaque ETag and checksum. */
+export async function openAcceptedChinaRegcloudFiles(storage:ObjectJsonStorage,
+ expected:{checksum:string;etag:string},role:'active'|'previous'){
+ const checksum=expected.checksum,etag=expected.etag;
+ const current=async()=>{
+  const own=await readChinaPublicState(storage);
+  if(!own||own.checksum!==checksum||own.etag!==etag)return fail('active_cut_changed');
+  return own;
+ };
+ const own=await current();
+ const ref=own.state[role];
+ if(!ref||chinaLegacyRollback(ref))return fail('accepted_ref');
+ return openChinaStageObject(storage,ref,async()=>{await current();},true);
