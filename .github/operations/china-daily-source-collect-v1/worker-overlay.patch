+}
+export function createChinaDailySourceAuthority(input:{plan:Buffer;expectedPlanSha256:string;actorRoot:string;workerRoot:string;
+ env?:NodeJS.ProcessEnv;fetchImpl?:typeof fetch}){
+ const p=parsePlan(input.plan,input.expectedPlanSha256),env=input.env??process.env,fetcher=input.fetchImpl??globalThis.fetch;
+ const actor=path.resolve(input.actorRoot),worker=path.resolve(input.workerRoot);
