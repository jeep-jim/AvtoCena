+  Object.keys(a.target).length!==3||!Number.isSafeInteger(a.revision)||a.revision<1||!ROOT.test(a.archiveRoot??'')||
+  ![a.controlSha256,a.archiveSha256,a.snapshotConfigSha256].every(x=>SHA.test(x??''))||
+  (a.bootstrapReceiptSha256!==undefined&&!SHA.test(a.bootstrapReceiptSha256))||
+  Object.keys(a).some(k=>!names.includes(k)&&k!=='bootstrapReceiptSha256'))return fail('plan_scope');
+ return a;
+}
+export async function inspectChinaDailyDry(input:{plan:Buffer;expectedPlanSha256:string;snapshotConfig:Buffer;bootstrapReceipt?:Buffer;onVerifiedReplicaChunk?:(chunk:Buffer,index:number)=>Promise<void>;onVerifiedBase?:(base:ChinaDailyNativeBase)=>void}){
+ const p=parseApproved(input.plan,input.expectedPlanSha256);
+ if(!cfg(readConfiguredRegcloudScope()))return fail('storage_scope');
+ if(!Buffer.isBuffer(input.snapshotConfig)||input.snapshotConfig.length>128*1024||sha(input.snapshotConfig)!==p.snapshotConfigSha256||
+    p.bootstrapReceiptSha256!==(input.bootstrapReceipt?sha(input.bootstrapReceipt):undefined))return fail('local_input_pin');
