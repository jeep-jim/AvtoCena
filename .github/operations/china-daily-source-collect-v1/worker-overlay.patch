+  key===p.archiveRoot+'/complete.json'||(key.startsWith(p.archiveRoot+'/files/report.json/')&&/^\d+-[a-f0-9]{64}\.json$/.test(key.slice(p.archiveRoot.length+19)))||
+  (key.startsWith(cutPrefix)&&key.split('/').every(x=>/^[a-zA-Z0-9_.-]+$/.test(x)&&x!=='.'&&x!=='..'));
