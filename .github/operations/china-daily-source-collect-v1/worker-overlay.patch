+ const now=Date.now(),mono=performance.now(),clock=()=>now+Math.max(performance.now()-mono,Date.now()-now);
+ need(GIT.test(actorRevision??'')&&actorRevision!==p.workerHead&&ID.test(runId??'')&&
+  typeof token==='string'&&/^[A-Za-z0-9_]{10,1024}$/.test(token)&&realpathSync(actor)===actor&&realpathSync(worker)===worker&&actor!==worker&&
+  path.dirname(worker)===actor&&worker===path.dirname(path.dirname(fileURLToPath(import.meta.url))),'bound_runtime_roots');
+ // Record actual Actions writer identity as owner; worker code gets its own attestation.
+ const owner=Object.freeze({runId:runId!,attempt:'1',revision:actorRevision!});
+ const checkEnv=()=>need(env.GITHUB_REPOSITORY===REPO&&env.GITHUB_REPOSITORY_ID===REPO_ID&&env.GITHUB_REF==='refs/heads/main'&&
+  env.GITHUB_WORKFLOW_REF===REPO+'/'+CHINA_DAILY_SOURCE_WORKFLOW+'@refs/heads/main'&&env.GITHUB_EVENT_NAME==='push'&&env.GITHUB_JOB==='collect'&&
+  env.GITHUB_RUN_ID===runId&&env.GITHUB_RUN_ATTEMPT==='1'&&env.GITHUB_SHA===actorRevision&&env.GITHUB_TOKEN===token,'job_environment');
+ const workerCheck=()=>{
+  need(git(worker,'rev-parse','--verify','HEAD').toString().trim()===p.workerHead&&git(worker,'write-tree').toString().trim()===p.workerTree&&
+    git(worker,'diff','--name-only','--').length===0&&git(worker,'ls-files','--others','--exclude-standard','--','apps','packages','scripts','data').length===0&&
+    git(worker,'ls-files','--others','--ignored','--exclude-standard','--','apps','packages','scripts','data').length===0&&
+    hash(safeFile(worker,'scripts/lib/nonjp-intake-archive.mjs',128*1024))===ARCHIVE,'worker_tree');
+ };
+ const actorCheck=()=>{
+  const workflow=safeFile(actor,CHINA_DAILY_SOURCE_WORKFLOW,128*1024),marker=safeFile(actor,CHINA_DAILY_SOURCE_MARKER,128);
+  need(git(actor,'rev-parse','--verify','HEAD').toString().trim()===owner.revision&&hash(workflow)===p.workflowSha256&&
+   workflow.equals(git(actor,'show',owner.revision+':'+CHINA_DAILY_SOURCE_WORKFLOW))&&
+   /^concurrency:\n {2}group: catalog-refresh-china\n {2}cancel-in-progress: false$/m.test(workflow.toString('utf8'))&&
+   marker.toString('ascii')===input.expectedPlanSha256+'\n'&&marker.equals(git(actor,'show',owner.revision+':'+CHINA_DAILY_SOURCE_MARKER)),'actor_tree');
+ };
+ async function req(url:string){return boundedJson(await fetcher(url,{method:'GET',redirect:'error',headers:{authorization:'Bearer '+token,
+  accept:'application/vnd.github+json','accept-encoding':'identity'},signal:AbortSignal.timeout(15_000)}));}
+ let nextCheck=0,deadline=0,initialReplica:string|undefined,flight:Promise<void>|undefined;
+ async function remote(){
+  checkEnv();actorCheck();workerCheck();
+  const self=API+'/'+runId,[run,jobs,active]=await Promise.all([req(self),req(self+'/attempts/1/jobs?per_page=100'),req(API+'?status=in_progress&per_page=100')]);
+  const job=jobs.jobs?.filter((row:any)=>row?.name===CHINA_DAILY_SOURCE_TITLE);
+  const started=Date.parse(job?.[0]?.started_at);
+  need(String(run.id)===runId&&run.run_attempt===1&&run.head_sha===actorRevision&&run.head_branch==='main'&&run.path===CHINA_DAILY_SOURCE_WORKFLOW&&
+   run.event==='push'&&run.status==='in_progress'&&run.head_commit?.message===CHINA_DAILY_SOURCE_TITLE&&
+   String(run.repository?.id)===REPO_ID&&run.repository?.full_name===REPO&&
+   Array.isArray(jobs.jobs)&&jobs.total_count===jobs.jobs.length&&jobs.total_count<=100&&job?.length===1&&
+   String(job[0].run_id)===runId&&job[0].head_sha===actorRevision&&job[0].status==='in_progress'&&
+   Number.isFinite(started)&&started<=clock()+5_000&&started+p.maxJobMs>clock(),'remote_job');
+  need(Array.isArray(active.workflow_runs)&&active.total_count===active.workflow_runs.length&&active.total_count<=100&&
+   active.workflow_runs.some((row:any)=>String(row.id)===runId&&row.path===CHINA_DAILY_SOURCE_WORKFLOW&&row.head_sha===actorRevision)&&
+   active.workflow_runs.every((row:any)=>String(row.id)===runId||!SOURCE_WORKFLOWS.has(row.path)),'source_lane_busy_or_unknown');
+  if(deadline)need(deadline===started+p.maxJobMs,'job_start_changed');
+  deadline=started+p.maxJobMs;nextCheck=clock()+60_000;
+ }
+ async function attest(force=false){
+  checkEnv();if(deadline)need(clock()<deadline,'job_deadline');
+  if(!deadline||force||clock()>=nextCheck){
+   if(!flight)flight=remote().finally(()=>{flight=undefined;});
+   await flight;
+  }
+  checkEnv();need(clock()<deadline,'job_deadline');
+ }
+ const authorize=async(claim:Claim)=>{
+  need(claim?.controlSha256===p.controlSha256&&claim.cursor===p.cursor&&SHA.test(claim.replicaSha256)&&
+    (!initialReplica||initialReplica===claim.replicaSha256),'accepted_claim');
+  await attest();initialReplica=claim.replicaSha256;
+ };
+ return Object.freeze({owner,workerHead:p.workerHead,workerTree:p.workerTree,dryPlanSha256:p.dryPlanSha256,attest,authorize,
+  async nativeWitness({storage,directory,config,owner:actual}:{storage:any;directory:string;config:any;owner:Owner}){
+   need(actual?.runId===owner.runId&&actual.attempt===owner.attempt&&actual.revision===owner.revision&&Boolean(initialReplica),'native_provenance');
+   await attest(true);workerCheck();
+   const witness=await verifyChe168ReplicaInput({storage,directory,config,producer:{runId:owner.runId,attempt:owner.attempt,sourceSha:owner.revision},independentDailySource:true});
+   await attest(true);return {sourceInputWitness:witness};
+  }});
+}
