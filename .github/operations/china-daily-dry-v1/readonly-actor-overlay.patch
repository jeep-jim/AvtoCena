+import {openIndependentChinaRegcloud,type IndependentCut} from './independent-market-activation-fixture';
+
+const SHA=/^[a-f0-9]{64}$/, ROOT=/^catalog\/nonjp-intake\/v1\/china\/[1-9]\d{0,19}\/[1-9]\d{0,5}$/;
+const REPLICA=/^catalog\/provider-replicas\/che168\/[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/;
+const MiB=1024**2, PART=2*MiB, REPLICA_PART=16*MiB, MAX_REPORT=128*MiB, MAX_RECEIPT=16*1024;
+const fail=(reason:string):never=>{throw Error('china_daily_source:'+reason);};
+const sha=(b:Buffer)=>createHash('sha256').update(b).digest('hex');
+const parse=(bytes:Buffer)=>JSON.parse(new TextDecoder('utf-8',{fatal:true}).decode(bytes));
+const int=(n:unknown):n is number=>Number.isSafeInteger(n)&&Number(n)>0;
+type Source=IndependentCut['source'];
+type Anchor={root:string;manifestSha256:string;reportSha256:string;receiptSha256:string};
+type Replica={key:string;binding:string;cursor:number;sha256:string};
+export type ChinaDailySourceCheckpoint={
+ version:1;kind:'china-daily-source-checkpoint-v1';market:'china';archive:Anchor;replica:Replica;
+ observedAt:number;sourceRows:number;
+};
+export type ChinaDailyBase={checksum:string;etag:string};
+
+function anchorFromReceipt(b:Buffer,source:Source,archiveSha256:string):Anchor{
+ if(!Buffer.isBuffer(b)||b.length<1||b.length>MAX_RECEIPT||sha(b)!==source.receiptSha256)return fail('receipt_sha');
+ const raw=parse(b);
+ let receipt;try{receipt=assertDurableIntakeArchive(raw,'china');}catch{return fail('archive_receipt');}
+ if(receipt.manifestSha256!==archiveSha256||!ROOT.test(receipt.root))return fail('archive_receipt');
+ return {root:receipt.root,manifestSha256:receipt.manifestSha256,reportSha256:receipt.reportDigest,receiptSha256:source.receiptSha256};
+}
+async function openArchiveSource(storage:ObjectJsonStorage,anchor:Anchor,source:Source,archiveSha256:string,guard:()=>Promise<void>,verifyReplicaParts:boolean,expectedSnapshotBinding?:string){
+ if(!anchor||!ROOT.test(anchor.root)||![anchor.manifestSha256,anchor.receiptSha256,anchor.reportSha256].every(x=>SHA.test(x??''))||
+    anchor.manifestSha256!==archiveSha256||anchor.receiptSha256!==source.receiptSha256||source.cursor.stream!=='che168')return fail('archive_scope');
+ const read=async(key:string,max:number)=>{await guard();const r=await storage.getBinaryBounded(key,max);await guard();return r.data;};
+ const manifest=parse(await read(anchor.root+'/complete.json',2*MiB));
+ if(chinaObjectDigest(manifest)!==archiveSha256||manifest?.version!==1||manifest.kind!=='nonjp-intake'||manifest.market!=='china'||
+    manifest.collection?.complete!==true||manifest.reportDigest!==anchor.reportSha256||!Array.isArray(manifest.files)||manifest.files.length>20_000||
+    anchor.root!=='catalog/nonjp-intake/v1/china/'+manifest.owner?.runId+'/'+manifest.owner?.attempt)return fail('archive_manifest');
+ const entries=manifest.files.filter((f:{name?:string}|null)=>f?.name==='report.json');
+ const f=entries[0];
+ if(entries.length!==1||!int(f.bytes)||f.bytes>MAX_REPORT||f.sha256!==anchor.reportSha256||!Array.isArray(f.parts)||
+    f.parts.length!==Math.ceil(f.bytes/PART))return fail('archive_report_manifest');
+ const bytes=Buffer.alloc(f.bytes),hash=createHash('sha256');
+ for(const [i,part] of f.parts.entries()){
+  const size=Math.min(PART,f.bytes-i*PART);
+  if(!SHA.test(part?.sha256??'')||part.bytes!==size||part.key!==anchor.root+'/files/report.json/'+i+'-'+part.sha256+'.json')
+   return fail('report_shard_scope');
+  const wire=parse(await read(part.key,4*MiB));
+  if(wire?.version!==1||wire.encoding!=='gzip-base64'||wire.sha256!==part.sha256||wire.bytes!==size||
+     typeof wire.payload!=='string'||wire.payload.length>4*MiB)return fail('report_shard_wire');
+  const encoded=Buffer.from(wire.payload,'base64');
+  if(encoded.toString('base64')!==wire.payload)return fail('report_shard_wire');
+  let raw;try{raw=gunzipSync(encoded,{maxOutputLength:size});}catch{return fail('report_shard_integrity');}
+  if(raw.length!==size||sha(raw)!==part.sha256)return fail('report_shard_integrity');
+  raw.copy(bytes,i*PART);hash.update(raw);
+ }
+ if(hash.digest('hex')!==anchor.reportSha256)return fail('report_sha');
+ const report=parse(bytes),matches=Array.isArray(report?.sources)?report.sources.filter((x:{provider?:string}|null)=>x?.provider==='auto_api_che168'):[];
+ const next=matches[0],replica=next?.replica;
+ if(report?.version!==1||report.market!=='china'||report.provider!=='auto_api_che168'||report.completed!==true||report.failure||
+    Date.parse(report.completedAt)!==source.observedAt||matches.length!==1||next.sourceId!=='autohome_used_china_open'||
+    next.completeInventory!==true||next.stopReason!=='source_finished'||next.rejectedIdentity!==0||
+    !int(next.uniqueOffers)||next.uniqueOffers!==next.observations||!int(next.initialCursor)||next.initialCursor>next.cursor||
+    next.cursor!==source.cursor.sequence||!REPLICA.test(replica?.key??'')||replica.sha256!==source.cursor.anchorSha256||
+    replica.cursor!==next.cursor||!SHA.test(replica.binding??'')||replica.binding!==next.snapshotBinding)return fail('report_source');
+ if(expectedSnapshotBinding!==undefined&&replica.binding!==expectedSnapshotBinding)return fail('snapshot_binding');
+ const replicaManifest=parse(await read(replica.key+'/manifest.json',2*MiB));
+ if(chinaObjectDigest(replicaManifest)!==replica.sha256||replicaManifest?.version!==1||
+    replicaManifest.binding!==replica.binding||replicaManifest.cursor!==replica.cursor||!int(replicaManifest.bytes)||
+    !Array.isArray(replicaManifest.parts)||replicaManifest.parts.length!==Math.ceil(replicaManifest.bytes/REPLICA_PART)||
+    replicaManifest.parts.length>1024)return fail('replica_manifest');
+ for(const [i,part] of replicaManifest.parts.entries()){
+  const size=Math.min(REPLICA_PART,replicaManifest.bytes-i*REPLICA_PART);
+  if(part?.bytes!==size||!SHA.test(part.sha256??''))return fail('replica_manifest');
+  if(!verifyReplicaParts)continue;
+  await guard();
+  const gzip=await storage.getChinaReplicaPartBounded(replica.key+'/'+i+'.gz',Math.min(17*MiB,size+65_536));
+  let raw;try{raw=gunzipSync(gzip,{maxOutputLength:size});}catch{return fail('replica_shard_integrity');}
+  if(raw.length!==size||sha(raw)!==part.sha256)return fail('replica_shard_integrity');
+ }
+ await guard();
+ const descriptor:Replica={key:replica.key,binding:replica.binding,cursor:replica.cursor,sha256:replica.sha256};
+ const checkpoint:ChinaDailySourceCheckpoint={version:1,kind:'china-daily-source-checkpoint-v1',market:'china',archive:anchor,
+  replica:descriptor,observedAt:source.observedAt,sourceRows:next.uniqueOffers};
+ return {checkpoint,initialCursor:next.initialCursor as number,baseReplica:next.baseReplica as {key?:string;sha256?:string}|undefined};
+}
+
+function activeGuard(stage:ChinaStageObjectFiles,cut:{assertCurrent:()=>Promise<void>}){
+ return async()=>{await cut.assertCurrent();await stage.assertPointer();};
+}
+/** Existing v1 first-cut READY needs no rewrite. An optional bootstrap
+ * receipt must be byte-exact to its own cut, not to a legacy cursor. */
+export async function openChinaDailyAcceptedSource(storage:ObjectJsonStorage,expected:ChinaDailyBase,bootstrapReceipt?:Buffer,expectedSnapshotBinding?:string){
+ return openAcceptedSource(storage,expected,bootstrapReceipt,true,expectedSnapshotBinding);
+}
+async function openAcceptedSource(storage:ObjectJsonStorage,expected:ChinaDailyBase,bootstrapReceipt:Buffer|undefined,verifyReplicaParts:boolean,expectedSnapshotBinding?:string){
+ const stage=await openAcceptedChinaRegcloudFiles(storage,expected,'active');
+ const opened=await openIndependentChinaRegcloud(stage).openChinaPrepared(),source=opened.cut.source,guard=activeGuard(stage,opened);
+ const [stored,archiveSha256]=[await stage.readDailySourceCheckpoint(),stage.ready.archiveSha256];
+ if(stored&&bootstrapReceipt)return fail('bootstrap_not_permitted');
+ const decoded=stored?parse(stored) as ChinaDailySourceCheckpoint:null;
+ if(!decoded&&!bootstrapReceipt)return fail('bootstrap_receipt_required');
+ const anchor=decoded?decoded.archive:anchorFromReceipt(bootstrapReceipt!,source,archiveSha256);
+ const result=await openArchiveSource(storage,anchor,source,archiveSha256,guard,verifyReplicaParts,expectedSnapshotBinding);
+ if(decoded&&chinaObjectDigest(result.checkpoint)!==sha(stored!))return fail('checkpoint_binding');
+ await guard();
+ return {checkpoint:result.checkpoint,assertCurrent:guard};
+}
+
+export async function bindChinaDailyStageSource(input:{
+ storage:ObjectJsonStorage;base:ChinaDailyBase;expectedBaseSha256:string;
+ candidate:Source;archiveSha256:string;receipt:Buffer;bootstrapReceipt?:Buffer;
+}){
+ const current=await openAcceptedSource(input.storage,input.base,input.bootstrapReceipt,false);
+ // The opaque state witness fixes the exact cursor/pointer revision while
+ // expectedBaseSha256 must also match the active reference of that witness.
+ const stage=await openAcceptedChinaRegcloudFiles(input.storage,input.base,'active');
+ if(stage.acceptedRefSha256!==input.expectedBaseSha256)return fail('base_ref');
+ const anchor=anchorFromReceipt(input.receipt,input.candidate,input.archiveSha256);
+ const next=await openArchiveSource(input.storage,anchor,input.candidate,input.archiveSha256,current.assertCurrent,true);
+ const prev=current.checkpoint.replica,replica=next.checkpoint.replica;
+ if(next.initialCursor!==prev.cursor||next.baseReplica?.key!==prev.key||next.baseReplica.sha256!==prev.sha256||
+    replica.binding!==prev.binding||replica.cursor<prev.cursor||
+    (replica.cursor===prev.cursor&&(replica.key!==prev.key||replica.sha256!==prev.sha256)))return fail('replica_ancestry');
+ await current.assertCurrent();
+ return {bytes:Buffer.from(JSON.stringify(next.checkpoint)),assertCurrent:current.assertCurrent};
+}
