+/** Owner-run China-only compare-and-swap; never changes Nginx, containers, or cursors. */
+import {createHash} from 'node:crypto';
+import {ObjectJsonStorage} from '../apps/web/lib/data';
+import {chinaObjectDigest,chinaLegacyRollback,validChinaPublicRef,readChinaPublicState,readConfiguredRegcloudScope,
+ assertChinaLegacyRollback,openChinaStageObjectFiles,type ChinaLegacyRollback,type ChinaPublicRef} from '../apps/web/lib/catalog/china-regcloud-object-reader';
+import {switchChinaRegcloudCut,type ChinaOwnSwitchPermit,type VerifiedChinaRuntimeProbe} from '../apps/web/lib/catalog/china-regcloud-cut-switch';
+
+const REPO='jeep-jim/AvtoCena',REPO_ID='1289722938';
+export const WORKFLOW='.github/workflows/china-own-control-switch-v1.yml';
+export const JOB='Switch exact China cut without traffic';
+const SHA=/^[a-f0-9]{64}$/,GIT=/^[a-f0-9]{40}$/,RUN=/^[1-9][0-9]{0,19}$/;
+const ID=/^[A-Za-z0-9_:-]{1,150}$/;
+const boundStorage=Object.freeze({endpoint:'https://s3.regru.cloud',bucket:'avtocena-staging-8120751',
+ prefix:'migration-staging/full-20261011',region:'us-east-1'});
+const sha=(value:Buffer|string)=>createHash('sha256').update(value).digest('hex');
+export const failChinaDarkSwitch=(code:string):never=>{throw Error('china_dark_switch:'+code);};
+const need=(v:unknown,c:string)=>{if(!v)failChinaDarkSwitch(c);};
+const TAG='china-dark-switch-approved-v1';
+const positive=(n:unknown):n is number=>Number.isSafeInteger(n)&&Number(n)>0;
+type Query={make:string;model:string};
+type Instance={release:string;calculationVersion:string;imageSha256:string;name:string;port:3000|3001};
+export type ChinaDarkSwitchPlan={
+ version:1;kind:typeof TAG;approvedScopeSha256:string;ownerJob:{runId:string;headSha:string;workflow:typeof WORKFLOW};
+ target:ChinaPublicRef;previous:ChinaLegacyRollback;expectedArchiveSha256:string;expectedManifestSha256:string;expectedPricingReceiptSha256:string;
+ expectedAdmittedRows:number;expectedBaseSha256:string;validUntil:number;rollbackUntil:number;previewBundleSha256:string;previewGrantSha256:string;
+ candidate:Instance;incumbent:Instance;query:Query;legacyQuery:Query;
+ writeExactly:'china-independent-control-only'|'no-publication';noIngressChange:true;cursorAdvanceAuthorized:false;
+};
+const validQuery=(q:Query)=>q&&Object.keys(q).length===2&&[q.make,q.model].every(x=>typeof x==='string'&&x.length>0&&x.length<=64&&!/[\u0000-\u001f\u007f]/.test(x));
+const validInstance=(i:Instance)=>i&&GIT.test(i.release)&&SHA.test(i.calculationVersion)&&SHA.test(i.imageSha256)&&[3000,3001].includes(i.port);
+export function parseChinaDarkSwitchPlan(raw:Buffer,expectedSha:string,rollbackWindow=false):Readonly<ChinaDarkSwitchPlan>{
+ need(Buffer.isBuffer(raw)&&raw.length>0&&raw.length<=64*1024&&SHA.test(expectedSha)&&sha(raw)===expectedSha,'approved_bytes');
+ const p=JSON.parse(new TextDecoder('utf-8',{fatal:true}).decode(raw)) as ChinaDarkSwitchPlan;
+ need(p?.version===1&&p.kind===TAG&&SHA.test(p.approvedScopeSha256)&&p.ownerJob?.workflow===WORKFLOW&&
+  RUN.test(p.ownerJob.runId)&&GIT.test(p.ownerJob.headSha)&&validChinaPublicRef(p.target)&&p.target.runId.startsWith('full-fresh-')&&
+  chinaLegacyRollback(p.previous)&&p.target.generationId!==p.previous.generationId&&SHA.test(p.previous.manifestSha256)&&
+  [p.expectedArchiveSha256,p.expectedManifestSha256,p.expectedPricingReceiptSha256,p.expectedBaseSha256,p.previewBundleSha256,p.previewGrantSha256].every(x=>SHA.test(x))&&
+  p.expectedBaseSha256===chinaObjectDigest(null)&&positive(p.expectedAdmittedRows)&&
+  positive(p.validUntil)&&positive(p.rollbackUntil)&&(rollbackWindow?p.rollbackUntil:p.validUntil)> Date.now()&&p.validUntil<=Date.now()+15*60_000&&
+  p.rollbackUntil>=p.validUntil+60_000&&p.rollbackUntil<=p.validUntil+5*60_000&&
+  (p.writeExactly==='china-independent-control-only'||p.writeExactly==='no-publication')&&p.noIngressChange===true&&p.cursorAdvanceAuthorized===false&&
+  validInstance(p.candidate)&&validInstance(p.incumbent)&&p.candidate.port!==p.incumbent.port&&
+  p.candidate.release!==p.incumbent.release&&p.candidate.imageSha256!==p.incumbent.imageSha256&&
+  p.incumbent.name==='avtocena-production'&&p.candidate.name==='avtocena-china-candidate-'+p.candidate.release.slice(0,12)&&
+  validQuery(p.query)&&validQuery(p.legacyQuery),'plan_scope');
+ const deepFreeze=(x:any):any=>{if(!x||typeof x!=='object')return x;Object.values(x).forEach(deepFreeze);return Object.freeze(x);};
+ return deepFreeze(p);
+}
+async function boundedJson(res:Response,max:number,code:string){
+ if(res.status!==200||!res.body){await res.body?.cancel();return failChinaDarkSwitch(code);}
+ const chunks:Uint8Array[]=[];let n=0;
+ for await(const chunk of res.body){n+=chunk.byteLength;if(n>max)return failChinaDarkSwitch(code+'_limit');chunks.push(chunk);}
+ try{return JSON.parse(new TextDecoder('utf-8',{fatal:true}).decode(Buffer.concat(chunks,n)));}
+ catch{return failChinaDarkSwitch(code+'_json');}
+}
+export function createChinaSwitchJobAuthenticator(plan:Readonly<ChinaDarkSwitchPlan>,env:NodeJS.ProcessEnv=process.env,fetchImpl=globalThis.fetch){
+ const {ownerJob:o}=plan,token=env.GITHUB_TOKEN;
+ const envMatches=()=>env.GITHUB_REPOSITORY===REPO&&env.GITHUB_REPOSITORY_ID===REPO_ID&&env.GITHUB_SHA===o.headSha&&
+  env.GITHUB_REF==='refs/heads/main'&&env.GITHUB_WORKFLOW_REF===REPO+'/'+WORKFLOW+'@refs/heads/main'&&
+  env.GITHUB_JOB==='switch'&&env.GITHUB_RUN_ID===o.runId&&env.GITHUB_RUN_ATTEMPT==='1'&&
+  typeof token==='string'&&token.length>=10&&token.length<=1024&&!/[\r\n\x00]/.test(token)&&env.GITHUB_TOKEN===token;
+ return async()=>{
+  need(envMatches(),'job_environment');
+  const endpoint='https://api.github.com/repos/'+REPO+'/actions/runs/'+o.runId;
+  const request=async(suffix:string)=>boundedJson(await fetchImpl(endpoint+suffix,{method:'GET',redirect:'error',
+   headers:{authorization:'Bearer '+token,accept:'application/vnd.github+json','accept-encoding':'identity'},signal:AbortSignal.timeout(10_000)}),1024*1024,'job_read');
+  const [run,jobs]=await Promise.all([request(''),request('/attempts/1/jobs?per_page=100')]);
+  const matching=jobs.jobs?.filter((j:any)=>j.name===JOB);
+  need(envMatches()&&String(run.id)===o.runId&&run.run_attempt===1&&run.head_sha===o.headSha&&
+   run.head_branch==='main'&&run.path===WORKFLOW&&run.event==='push'&&run.status==='in_progress'&&
+   String(run.repository?.id)===REPO_ID&&run.repository?.full_name===REPO&&Array.isArray(jobs.jobs)&&jobs.total_count===jobs.jobs.length&&
+   jobs.total_count<=100&&matching?.length===1&&matching[0].status==='in_progress'&&
+   String(matching[0].run_id)===o.runId&&matching[0].head_sha===o.headSha,'job_remote_identity');
+ };
+}
+function requireProbe(proof:VerifiedChinaRuntimeProbe,plan:Readonly<ChinaDarkSwitchPlan>,kind:VerifiedChinaRuntimeProbe['kind']){
+ const legacy=kind==='normal-china-legacy-readback',instance=legacy?plan.incumbent:plan.candidate;
+ need(proof?.version===1&&proof.kind===kind&&proof.generationId===(legacy?plan.previous.generationId:plan.target.generationId)&&
+  proof.buildSha256===instance.imageSha256&&positive(proof.checkedAt)&&Math.abs(Date.now()-proof.checkedAt)<=60_000&&proof.checkedAt<=Date.now()&&
+  ID.test(proof.cardId)&&positive(proof.listRub)&&proof.listRub===proof.detailRub&&positive(proof.filteredCount)&&
+  (legacy?proof.legacyManifestSha256===plan.previous.manifestSha256&&proof.readySha256===undefined:
+   proof.readySha256===plan.target.readySha256&&proof.legacyManifestSha256===undefined&&proof.filteredCount<=plan.expectedAdmittedRows),'probe_evidence');
+}
+type Services={
+ storage:ObjectJsonStorage;assertOwnerJob:()=>Promise<void>;assertDarkLease:()=>Promise<void>;
+ privateCandidate:()=>Promise<VerifiedChinaRuntimeProbe>;normalCandidate:(privateProof:VerifiedChinaRuntimeProbe)=>Promise<VerifiedChinaRuntimeProbe>;
+ normalLegacy:()=>Promise<VerifiedChinaRuntimeProbe>;
+ storeOrdinaryProof?:(proof:VerifiedChinaRuntimeProbe)=>Promise<void>;
+ onPhase?:(phase:'scope_and_owner'|'host_lease'|'own_baseline'|'legacy_manifest'|'candidate_ready'|'legacy_http'|'private_candidate'|'control_cas'|'prepared_http'|'final_readback')=>void;
+};
+export function expectedDarkControlSha256(p:Readonly<ChinaDarkSwitchPlan>){
+ return chinaObjectDigest({version:1,market:'china',revision:1,active:p.target,previous:p.previous});
+}
+/** Ingress failure fallback: callable only after incumbent ingress and the
+ * same actor/job lease are proved again, within its pre-approved rollback window. */
+export async function runChinaDarkControlRollback(raw:Buffer,expectedPlanSha:string,expectedCurrentSha:string,services:Pick<Services,'storage'|'assertOwnerJob'|'assertDarkLease'|'normalLegacy'>){
+ const p=parseChinaDarkSwitchPlan(raw,expectedPlanSha,true),{storage}=services;
+ need(p.writeExactly==='china-independent-control-only','rollback_authority');
+ need(expectedCurrentSha===expectedDarkControlSha256(p),'rollback_current_pin');
+ const guard=async()=>{
+  need(Date.now()<p.rollbackUntil,'deadline');
+  const scope=readConfiguredRegcloudScope();
+  need(Object.entries(boundStorage).every(([k,v])=>scope[k as keyof typeof scope]===v),'storage_scope');
+  await services.assertOwnerJob();await services.assertDarkLease();
+ };
+ await guard();
+ need((await readChinaPublicState(storage))?.checksum===expectedCurrentSha,'rollback_current_changed');
+ const proof=await services.normalLegacy();requireProbe(proof,p,'normal-china-legacy-readback');
+ const permit:ChinaOwnSwitchPermit={version:1,kind:'china-own-public-cut-cas-v1',market:'china',action:'rollback',storage:boundStorage,
+  expectedBaseSha256:chinaObjectDigest(p.target),expectedPublicControlSha256:expectedCurrentSha,target:p.previous,
+  expectedRuntimeProbeSha256:chinaObjectDigest(proof),validUntil:p.rollbackUntil};
+ const pin=chinaObjectDigest(permit);
+ const restored=await switchChinaRegcloudCut({storage,permit,expectedPermitSha256:pin,
+  async assertApprovedRunner(_p,actual){need(actual===pin,'rollback_permit');await guard();},
+  async verifyNormalRuntimeReadback(){return proof;}});
+ need(chinaLegacyRollback(restored.state.active)&&restored.state.active.manifestSha256===p.previous.manifestSha256,'rollback_readback');
+ return {status:'legacy_china_control_restored' as const,controlSha256:restored.controlSha256,generationId:p.previous.generationId,
+  cursorAdvanced:false,publicIngressChanged:false};
+}
+type PreflightServices=Omit<Services,'normalCandidate'|'storeOrdinaryProof'>;
+async function preflight(p:Readonly<ChinaDarkSwitchPlan>,services:PreflightServices){
+ const {storage}=services,phase=services.onPhase??(()=>{});
+ const checkpoint=async(rollback=false,displayInitialPhase=false)=>{
+  need(Date.now()<(rollback?p.rollbackUntil:p.validUntil),'deadline');
+  const scope=readConfiguredRegcloudScope();
+  need(Object.entries(boundStorage).every(([k,v])=>scope[k as keyof typeof scope]===v),'storage_scope');
+  await services.assertOwnerJob();
+  if(displayInitialPhase)phase('host_lease');
+  await services.assertDarkLease();
+ };
+ phase('scope_and_owner');await checkpoint(false,true);
+ phase('own_baseline');need(await readChinaPublicState(storage)===null,'initial_control_not_absent');
+ phase('legacy_manifest');await assertChinaLegacyRollback(storage,p.previous);
+ phase('candidate_ready');const stage=await openChinaStageObjectFiles(storage,p.target,async()=>{
+  await services.assertDarkLease();
+  need(await readChinaPublicState(storage)===null,'initial_control_changed');
+ });
+ need(stage.durable.archiveSha256===p.expectedArchiveSha256&&stage.durable.manifestSha256===p.expectedManifestSha256&&stage.durable.pricingReceiptSha256===p.expectedPricingReceiptSha256&&
+   stage.durable.admittedRows===p.expectedAdmittedRows&&stage.durable.expectedChinaPublicBaseSha256===p.expectedBaseSha256,'ready_identity');
+ phase('legacy_http');const legacy=await services.normalLegacy();requireProbe(legacy,p,'normal-china-legacy-readback');
+ phase('private_candidate');const privateProof=await services.privateCandidate();requireProbe(privateProof,p,'private-china-candidate-readback');
+ return {privateProof,checkpoint};
+}
+/** Same pre-CAS probes as the writer, but this path cannot construct a permit,
+ * enter the switch/rollback code or produce an ingress receipt. */
+export async function verifyChinaDarkControlOnly(raw:Buffer,expectedPlanSha:string,services:PreflightServices){
+ const p=parseChinaDarkSwitchPlan(raw,expectedPlanSha);
+ need(p.writeExactly==='no-publication','verify_only_authority');
+ const {checkpoint}=await preflight(p,services);
+ services.onPhase?.('final_readback');await checkpoint();
+ need(await readChinaPublicState(services.storage)===null,'initial_control_changed');
+ return {status:'china_prepublication_verified' as const,generationId:p.target.generationId,storageWrites:0,publicIngressChanged:false,cursorAdvanced:false};
+}
+/** Internal reviewed host actor. The shell supplies real lease/image/ingress
+ * checks and probes through the same fixed private process; no public API. */
+export async function runChinaDarkControlSwitch(raw:Buffer,expectedPlanSha:string,services:Services){
+ const p=parseChinaDarkSwitchPlan(raw,expectedPlanSha),{storage}=services;
+ need(p.writeExactly==='china-independent-control-only','activation_authority');
+ const {privateProof,checkpoint}=await preflight(p,services);
+ const permit:ChinaOwnSwitchPermit={version:1,kind:'china-own-public-cut-cas-v1',market:'china',action:'activate',storage:boundStorage,
+  expectedBaseSha256:p.expectedBaseSha256,expectedPublicControlSha256:null,target:p.target,bootstrapPrevious:p.previous,
+  expectedRuntimeProbeSha256:chinaObjectDigest(privateProof),validUntil:p.validUntil,darkActivation:'isolated-runtime-before-ingress'};
+ const permitSha=chinaObjectDigest(permit);
+ const exactNew=expectedDarkControlSha256(p);
+ let attempted=false;
+ try{
+  services.onPhase?.('control_cas');await checkpoint();
+  attempted=true;
+  const write=await switchChinaRegcloudCut({storage,permit,expectedPermitSha256:permitSha,
+   async assertApprovedRunner(_p,actual){need(actual===permitSha,'activate_permit');await checkpoint();},
+   assertSameDarkRuntimeLease:services.assertDarkLease,
+   async verifyNormalRuntimeReadback(){requireProbe(privateProof,p,'private-china-candidate-readback');return privateProof;}});
+  need(write.controlSha256===exactNew,'written_pointer_identity');
+  await checkpoint();
+  services.onPhase?.('prepared_http');const proof=await services.normalCandidate(privateProof);requireProbe(proof,p,'normal-china-runtime-readback');
+  need(proof.cardId===privateProof.cardId&&proof.listRub===privateProof.listRub&&proof.filteredCount===privateProof.filteredCount,'private_normal_parity');
+  await checkpoint();
+  need((await readChinaPublicState(storage))?.checksum===exactNew,'postcheck_pointer_changed');
+  await services.storeOrdinaryProof?.(proof);
+  return {status:'china_dark_control_verified' as const,controlSha256:exactNew,generationId:p.target.generationId,
+   runtimeRelease:p.candidate.release,publicIngressChanged:false,cursorAdvanced:false};
+ }catch(error){
+  if(!attempted)throw error;
+  let observed;
+  try{observed=await readChinaPublicState(storage);}catch{return failChinaDarkSwitch('pointer_outcome_unknown_do_not_repeat');}
+  if(!observed)throw error;
+  // Never overwrite a racing or unidentifiable control, even for rollback.
+  if(observed.checksum!==exactNew)return failChinaDarkSwitch('pointer_changed_do_not_repeat');
+  try{
+   await checkpoint(true);
+   // Refresh actual still-serving legacy proof; it is not the candidate
+   // payload or a synthetic request result. If unavailable, leave for owner.
+   const keep=await services.normalLegacy();requireProbe(keep,p,'normal-china-legacy-readback');
+   const back:ChinaOwnSwitchPermit={version:1,kind:'china-own-public-cut-cas-v1',market:'china',action:'rollback',storage:boundStorage,
+    expectedBaseSha256:chinaObjectDigest(p.target),expectedPublicControlSha256:exactNew,target:p.previous,
+    expectedRuntimeProbeSha256:chinaObjectDigest(keep),validUntil:p.rollbackUntil};
+   const backSha=chinaObjectDigest(back);
+   const reverted=await switchChinaRegcloudCut({storage,permit:back,expectedPermitSha256:backSha,
+    async assertApprovedRunner(_p,actual){need(actual===backSha,'rollback_permit');await checkpoint(true);},
+    async verifyNormalRuntimeReadback(){return keep;}});
+   need(chinaLegacyRollback(reverted.state.active)&&reverted.state.active.manifestSha256===p.previous.manifestSha256,'rollback_readback');
+  }catch{return failChinaDarkSwitch('automatic_rollback_unverified_do_not_repeat');}
+  return failChinaDarkSwitch('candidate_failed_legacy_restored_no_ingress_change');
+ }
+}
