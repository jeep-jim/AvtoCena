{
  "manifest_version": 3,
  "name": "ИИ Бро — чат с помощниками",
  "version": "1.0.5",
  "description": "Соединяет внутренний чат АвтоЦены с вашими аккаунтами ChatGPT, Алисы, Google и DeepSeek без API-ключей.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://alice.yandex.ru/*",
    "https://www.google.com/*",
    "https://google.com/*",
    "https://chat.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://avtocena.com/*",
        "https://www.avtocena.com/*"
      ],
      "js": [
        "site.js"
      ]
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://alice.yandex.ru/*",
        "https://www.google.com/*",
        "https://google.com/*",
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "chatgpt.js"
      ]
    }
  ]
}
